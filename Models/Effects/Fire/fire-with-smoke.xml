<?xml version="1.0"?>

<!-- Base fire flame plus a black smoke column above it. -->
<PropertyList>

	<path>../../Geometry/null.ac</path>

	<model>
		<path>fire-particles.xml</path>
		<name>Fire</name>
		<offsets>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
		</offsets>
	</model>

	<model>
		<path>fire-smoke.xml</path>
		<name>FireSmoke</name>
		<offsets>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
		</offsets>
	</model>

	<!-- *** LoD *** -->
	<animation>
		<type>range</type>
		<min-m>0</min-m>
		<max-m>6000</max-m>
	</animation>

</PropertyList>
