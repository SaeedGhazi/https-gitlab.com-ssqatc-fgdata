<?xml version="1.0" encoding="UTF-8"?>
<!--
  جلوه‌ی دود و آتش SSQ — نسخه‌ی بهبودیافته
  تغییرات کلیدی نسبت به نسخه‌ی قبل:
   ۱) دود:  emissive=false  ← رفعِ «مربع‌شدن»؛ blending معمولیِ alpha شکلِ PNG را درست می‌بُرد
   ۲) دود:  gravity=false   ← دود می‌رود بالا و برنمی‌گردد (FG جاذبه‌ی رو به پایین دارد، شناوری ندارد)
   ۳) دود:  شیب shooter (theta/phi) باز شد ← حرکت تصادفی و پخش‌شدن رو به بالا
   ۴) دود:  speed بیشتر + life طولانی‌تر ← تا ارتفاع بالا می‌رود
   ۵) دود:  mass کم شد (۱۲۰→۲) ← باد و دراگِ هوا پخشش می‌کنند (جرم زیاد = اینرسی زیاد = بدون پخش)
   ۶) دود:  end-size بزرگ‌تر ← هرچه بالاتر، پخش‌تر
   ۷) حذف <drag> (در FlightGear پارس نمی‌شود؛ بی‌اثر بود)
  نکته: اگر بعد از emissive=false باز هم مربع دیدی، یعنی PNG کانال alpha واقعی ندارد
        (پس‌زمینه‌ی مات است) → باید PNG را با شفافیت واقعی ذخیره کنی.
-->
<PropertyList>

    <!-- ============================ آتش (شعله) ============================ -->
    <!-- شعله درخشان است → emissive=true درست است (additive، لبه‌های مشکیِ flame.png مشکلی ندارند) -->
    <particlesystem>
        <name>ssq-fire-flame</name>
        <texture>flame.png</texture>
        <emissive>true</emissive>
        <lighting>false</lighting>
        <attach>world</attach>

        <placer>
            <type>sector</type>
            <radius-min-m>0.0</radius-min-m>
            <radius-max-m>0.4</radius-max-m>
            <phi-min-deg>0</phi-min-deg>
            <phi-max-deg>360</phi-max-deg>
        </placer>

        <shooter>
            <theta-min-deg>80.0</theta-min-deg>   <!-- کمی بازتر از قبل برای سوسوی طبیعی -->
            <theta-max-deg>100.0</theta-max-deg>
            <phi-min-deg>-8.0</phi-min-deg>
            <phi-max-deg>8.0</phi-max-deg>
            <speed-mps> <value>35.0</value> <spread>5.0</spread> </speed-mps>
        </shooter>

        <counter>
            <particles-per-sec> <value>100</value> <spread>15</spread> </particles-per-sec>
        </counter>

        <align>billboard</align>

        <particle>
            <start>
                <color>
                    <red><value>1.0</value></red>
                    <green><value>0.5</value></green>
                    <blue><value>0.1</value></blue>
                    <alpha><value>0.95</value></alpha>
                </color>
                <size><value>0.6</value></size>
            </start>
            <end>
                <color>
                    <red><value>0.8</value></red>
                    <green><value>0.1</value></green>
                    <blue><value>0.0</value></blue>
                    <alpha><value>0.0</value></alpha>
                </color>
                <size><value>3.5</value></size>
            </end>
            <life-sec><value>0.4</value></life-sec>
            <mass-kg>0.02</mass-kg>
        </particle>

        <program>
            <fluid>air</fluid>
            <gravity>true</gravity>
            <wind>true</wind>
        </program>
    </particlesystem>

    <!-- ============================ دود ============================ -->
    <particlesystem>
        <name>ssq-fire-smoke</name>
        <texture>smoke-black.png</texture>
        <emissive>false</emissive>          <!-- ★ رفعِ مربع: blending معمولی alpha -->
        <lighting>false</lighting>
        <attach>world</attach>

        <placer>
            <type>sector</type>
            <radius-min-m>0.1</radius-min-m>
            <radius-max-m>0.6</radius-max-m>
            <phi-min-deg>0</phi-min-deg>
            <phi-max-deg>360</phi-max-deg>
        </placer>

        <shooter>
            <!-- ★ مخروطِ رو به بالا با پخشِ تصادفی (theta حول ۹۰=بالا، phi کاملِ ۳۶۰) -->
            <theta-min-deg>72.0</theta-min-deg>
            <theta-max-deg>108.0</theta-max-deg>
            <phi-min-deg>0.0</phi-min-deg>
            <phi-max-deg>360.0</phi-max-deg>
            <speed-mps> <value>8.0</value> <spread>3.0</spread> </speed-mps>  <!-- ★ بالاتر می‌رود -->
        </shooter>

        <counter>
            <particles-per-sec> <value>55</value> <spread>12</spread> </particles-per-sec>
        </counter>

        <align>billboard</align>

        <particle>
            <start>
                <color>
                    <red><value>0.18</value></red>
                    <green><value>0.18</value></green>
                    <blue><value>0.18</value></blue>
                    <alpha><value>0.55</value></alpha>   <!-- پررنگ‌تر تا دودِ تیره دیده شود -->
                </color>
                <size><value>1.5</value></size>
            </start>
            <end>
                <color>
                    <red><value>0.35</value></red>
                    <green><value>0.35</value></green>
                    <blue><value>0.35</value></blue>
                    <alpha><value>0.0</value></alpha>     <!-- محو‌شدن تدریجی -->
                </color>
                <size><value>14.0</value></size>          <!-- ★ پخش‌شدنِ زیاد در بالا -->
            </end>
            <life-sec><value>20.0</value></life-sec>      <!-- ★ عمر بلند = صعودِ زیاد -->
            <mass-kg>2.0</mass-kg>                          <!-- ★ سبک = باد/دراگ پخشش می‌کند -->
            <radius-m>2.0</radius-m>                        <!-- اندرکنش با هوا برای دراگ -->
        </particle>

        <program>
            <fluid>air</fluid>
            <gravity>false</gravity>     <!-- ★ بالا می‌رود و برنمی‌گردد -->
            <wind>true</wind>            <!-- باد سناریو = رانش و پخشِ طبیعی -->
        </program>
    </particlesystem>

</PropertyList>
