				</wrap-t>
				<internal-format>
					<use>texture[6]/internal-format</use>
				</internal-format>
			</texture-unit>

			<program>
				<vertex-shader>Shaders/water_lightfield.vert</vertex-shader>
				<fragment-shader>Shaders/water_lightfield_lr.frag</fragment-shader>
