   <width>70</width>
   <height>25</height>
   <property>/local-weather/tmp/conv-strength</property>
  </input>

<text>
  <x>165</x>
  <y>0</y>
  <label>alt (ft)</label>
 </text> 

<input>
   <x>245</x>
   <y>0</y>
   <width>70</width>
   <height>25</height>
   <property>/local-weather/tmp/conv-alt</property>
  </input>

