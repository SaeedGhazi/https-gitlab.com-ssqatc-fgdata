  </text>

<input>
   <x>125</x>
   <y>320</y>
   <width>30</width>
   <height>25</height>
   <property>/local-weather/tmp/windspeed-kt</property>
  </input>

 
  
<text>
   <x>157</x>
   <y>320</y>
   <label>gust freq.</label>
  </text>



