<?xml version="1.0"?>
<!--
  presets for the ever changing default airport
-->
<PropertyList>
  <sim>
    <presets>
      <airport-id>SBRJ</airport-id>
      <runway>20R</runway>
    </presets>
  </sim>
  <instrumentation>
    <!-- Radio settings -->
    <comm n="0">
      <frequencies>
        <!-- TWR -->
        <selected-mhz type="double">118.700</selected-mhz>
        <!-- APP -->
        <standby-mhz type="double">119.350</standby-mhz>
      </frequencies>
    </comm>
    <comm n="1">
      <frequencies>
        <!-- ATIS -->
        <selected-mhz type="double">132.650</selected-mhz>
        <!-- GND -->
        <standby-mhz type="double">121.700</standby-mhz>
      </frequencies>
    </comm>
    <nav n="0">
      <frequencies>
        <!-- IRJ LOC (20R) -->
        <selected-mhz type="double">111.10</selected-mhz>
        <!-- MARICA (MRC) VOR/DME -->
        <standby-mhz type="double">114.00</standby-mhz>
      </frequencies>
      <radials>
        <selected-deg type="double">196.0</selected-deg>
      </radials>
    </nav>
    <nav n="1">
      <frequencies>
        <!-- CAXIAS (CAX) VOR -->
        <selected-mhz type="double">113.00</selected-mhz>
        <!-- PIRAI (PAI) VOR -->
        <standby-mhz type="double">115.00</standby-mhz>
      </frequencies>
      <radials>
        <selected-deg type="double">120.0</selected-deg>
      </radials>
    </nav>
    <dme n="0">
      <serviceable type="bool" archive="y">true</serviceable>
      <switch-position type="int" archive="y">2</switch-position>
      <frequencies>
        <selected-mhz type="double">111.1</selected-mhz>
        <source>/instrumentation/nav[0]/frequencies/selected-mhz</source>
      </frequencies>
    </dme>
    <adf n="0">
      <frequencies>
        <!-- PAIOL (PP) -->
        <selected-khz type="int">415</selected-khz>
        <!-- CAXIAS NDB (CAX) -->
        <standby-khz type="int">400</standby-khz>
      </frequencies>
      <serviceable type="bool" archive="y">true</serviceable>
      <indicated-bearing-deg type="double">90</indicated-bearing-deg>
      <error-deg type="double">2</error-deg>
      <mode>adf</mode>
      <rotation-deg type="double">0</rotation-deg>
      <volume-norm type="double">0.5</volume-norm>
    </adf>
    <adf n="1">
      <frequencies>
        <selected-khz type="int">379</selected-khz>
        <standby-khz type="int">341</standby-khz>
      </frequencies>
      <serviceable type="bool" archive="y">true</serviceable>
      <indicated-bearing-deg type="double">90</indicated-bearing-deg>
      <error-deg type="double">2</error-deg>
      <mode>adf</mode>
      <rotation-deg type="double">0</rotation-deg>
      <volume-norm type="double">0.5</volume-norm>
    </adf>
  </instrumentation>
</PropertyList>
