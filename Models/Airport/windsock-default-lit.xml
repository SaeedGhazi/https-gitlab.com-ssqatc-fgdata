<?xml version="1.0"?>

<PropertyList>

 <path>windsock.ac</path>

 <animation>
  <type>rotate</type>
  <object-name>windsock</object-name>
  <object-name>frame</object-name>
  <property>/environment/wind-from-heading-deg</property>
  <offset-deg>-90</offset-deg>
  <factor>-1</factor>
  <axis>
   <x>0.0</x>
   <y>0.0</y>
   <z>1.0</z>
  </axis>
  <center>
   <x-m>0.0</x-m>
   <y-m>0.0</y-m>
   <z-m>0.0</z-m>
  </center>
 </animation>

