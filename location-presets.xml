<?xml version="1.0"?>
<!--
  presets for the ever changing default airport
-->
<PropertyList>
  <sim>
    <presets>
      <airport-id>PHNL</airport-id>
      <runway>04L</runway>
    </presets>
  </sim>
  <instrumentation>
    <!-- Radio settings -->
    <comm n="0">
      <frequencies>
        <!-- TWR -->
        <selected-mhz type="double">123.900</selected-mhz>
        <!-- DEP -->
        <standby-mhz type="double">118.300</standby-mhz>
      </frequencies>
    </comm>
    <comm n="1">
      <frequencies>
        <!-- ATIS -->
        <selected-mhz type="double">127.900</selected-mhz>
        <!-- GND -->
        <standby-mhz type="double">120.900</standby-mhz>
      </frequencies>
    </comm>
    <nav n="0">
      <frequencies>
        <!-- HONOLULU (HNL) -->
        <selected-mhz type="double">114.80</selected-mhz>
        <!-- KOKO HEAD (PR) -->
        <standby-mhz type="double">113.90</standby-mhz>
      </frequencies>
      <radials>
        <selected-deg type="double">243</selected-deg>
      </radials>
    </nav>
    <nav n="1">
      <frequencies>
        <!-- MOLOKAI (MKK) -->
        <selected-mhz type="double">116.100</selected-mhz>
        <!-- LANAI (LNY) -->
        <standby-mhz type="double">117.70</standby-mhz>
      </frequencies>
      <radials>
        <selected-deg type="double">326</selected-deg>
      </radials>
    </nav>
    <dme n="0">
      <serviceable type="bool" archive="y">true</serviceable>
      <switch-position type="int" archive="y">2</switch-position>
      <frequencies>
        <selected-mhz type="double">109.10</selected-mhz>
        <source>/instrumentation/nav[0]/frequencies/selected-mhz</source>
      </frequencies>
    </dme>
    <adf n="0">
      <frequencies>
        <!-- WHEELER (HHI) -->
        <selected-khz type="int">373</selected-khz>
        <!-- EWABE (HN) -->
        <standby-khz type="int">242</standby-khz>
      </frequencies>
      <serviceable type="bool" archive="y">true</serviceable>
      <indicated-bearing-deg type="double">90</indicated-bearing-deg>
      <error-deg type="double">2</error-deg>
      <mode>adf</mode>
      <rotation-deg type="double">0</rotation-deg>
      <volume-norm type="double">0.5</volume-norm>
    </adf>
    <adf n="1"> <!-- unset -->
      <frequencies>
        <!-- LANAI (LLD)-->
        <selected-khz type="int">353</selected-khz>
        <!-- VALLEY ISLAND (VYI) -->
        <standby-khz type="int">327</standby-khz>
      </frequencies>
      <serviceable type="bool" archive="y">true</serviceable>
      <indicated-bearing-deg type="double">90</indicated-bearing-deg>
      <error-deg type="double">2</error-deg>
      <mode>adf</mode>
      <rotation-deg type="double">0</rotation-deg>
      <volume-norm type="double">0.5</volume-norm>
    </adf>
  </instrumentation>
</PropertyList>
