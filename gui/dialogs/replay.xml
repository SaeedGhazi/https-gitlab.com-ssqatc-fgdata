				<command>property-toggle</command>
				<property>/sim/freeze/clock</property>
			</binding>
			<binding>
				<command>property-toggle</command>
				<property>/sim/freeze/master</property>
			</binding>
		</button>

		<button>
			<legend>End Replay</legend>
