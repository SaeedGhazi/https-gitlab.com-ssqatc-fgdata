 <!-- Button Box -->

 <group>
  <x>105</x>
  <y>10</y>

  <button>
   <x>0</x>
   <y>0</y>
   <legend>OK</legend>
   <default>true</default>
   <equal>true</equal>
   <binding>
    <command>dialog-apply</command>
   </binding>
   <binding>
    <command>reinit</command>
    <subsystem>environment</subsystem>
   </binding>
   <binding>
    <command>dialog-close</command>
   </binding>
  </button>


<button>
   <x>80</x>
   <y>0</y>
   <legend>Clear clouds</legend>
   <default>true</default>
   <equal>true</equal>
   <binding>
     <command>nasal</command>
     <script>local_weather.clear_all()</script>
   </binding>
  </button>

  <button>
   <x>200</x>
   <y>0</y>
   <legend>Cancel</legend>
   <equal>true</equal>
   <key>Esc</key>
   <binding>
    <command>dialog-close</command>
   </binding>
  </button>

 </group>

</PropertyList>
