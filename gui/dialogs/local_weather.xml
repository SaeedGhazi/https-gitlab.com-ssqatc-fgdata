<button>
   <x>490</x>
   <y>0</y>
   <legend>Draw streak</legend>
   <default>true</default>
   <equal>true</equal>
   <binding>
    <command>dialog-apply</command>
   </binding>
   <binding>
     <command>nasal</command>
     <script>local_weather.streak_wrapper()</script>
   </binding>
  </button>
</group>


<text>
  <x>10</x>
  <y>310</y>
  <label>Start the convective system</label>
 </text>

<group>
  <x>0</x>
  <y>270</y>

