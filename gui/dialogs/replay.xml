				<alpha type="float">0.8</alpha>
			</color>
			<!--<pref-width>47</pref-width>-->			
			<binding>
				<command>property-assign</command>
				<property>/sim/replay/disable</property>
				<value type="bool">true</value>
			</binding>
			<binding>
				<command>dialog-close</command>
			</binding>
		</button>

