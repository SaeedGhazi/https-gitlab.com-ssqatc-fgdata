<?xml version="1.0"?>
<!--
  presets for the ever changing default airport
-->
<PropertyList>
  <sim>
    <presets>
      <airport-id>LKPR</airport-id>
      <runway>24</runway>
    </presets>
  </sim>
  <instrumentation>
    <!-- Radio settings -->
    <comm n="0">
      <frequencies>
        <!-- TWR -->
        <selected-mhz type="double">118.100</selected-mhz>
        <!-- DEP -->
        <standby-mhz type="double">120.525</standby-mhz>
      </frequencies>
    </comm>
    <comm n="1">
      <frequencies>
        <!-- ATIS -->
        <selected-mhz type="double">122.150</selected-mhz>
        <!-- GND -->
        <standby-mhz type="double">121.900</standby-mhz>
      </frequencies>
    </comm>
    <nav n="0">
      <frequencies>
        <!-- PRAGUE (OKL) -->
        <selected-mhz type="double">112.70</selected-mhz>
        <!-- LOC 24 (PR) -->
        <standby-mhz type="double">109.10</standby-mhz>
      </frequencies>
      <radials>
        <selected-deg type="double">243</selected-deg>
      </radials>
    </nav>
    <nav n="1">
      <frequencies>
        <!-- VLASIM (VLM) -->
        <selected-mhz type="double">114.300</selected-mhz>
        <!-- VOZICE (VOZ) -->
        <standby-mhz type="double">116.30</standby-mhz>
      </frequencies>
      <radials>
        <selected-deg type="double">326</selected-deg>
      </radials>
    </nav>
    <dme n="0">
      <serviceable type="bool" archive="y">true</serviceable>
      <switch-position type="int" archive="y">2</switch-position>
      <frequencies>
        <selected-mhz type="double">109.10</selected-mhz>
        <source>/instrumentation/nav[0]/frequencies/selected-mhz</source>
      </frequencies>
    </dme>
    <adf n="0">
      <frequencies>
        <!-- RUZYNE NORTH NDB (PR) -->
        <selected-khz type="int">356</selected-khz>
        <!-- LIBOC NDB (L) -->
        <standby-khz type="int">372</standby-khz>
      </frequencies>
      <serviceable type="bool" archive="y">true</serviceable>
      <indicated-bearing-deg type="double">90</indicated-bearing-deg>
      <error-deg type="double">2</error-deg>
      <mode>adf</mode>
      <rotation-deg type="double">0</rotation-deg>
      <volume-norm type="double">0.5</volume-norm>
    </adf>
    <adf n="1"> <!-- unset -->
      <frequencies>
        <!-- XXXXX NDB (XX)-->
        <selected-khz type="int">382</selected-khz>
        <!-- XXXXX NDB (XX) -->
        <standby-khz type="int">251</standby-khz>
      </frequencies>
      <serviceable type="bool" archive="y">true</serviceable>
      <indicated-bearing-deg type="double">90</indicated-bearing-deg>
      <error-deg type="double">2</error-deg>
      <mode>adf</mode>
      <rotation-deg type="double">0</rotation-deg>
      <volume-norm type="double">0.5</volume-norm>
    </adf>
  </instrumentation>
</PropertyList>
