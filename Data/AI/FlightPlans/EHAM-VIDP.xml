<?xml version="1.0"?>

<!-- this is a very simple prototype FlightPlan -->
 
<PropertyList>

 <flightplan>

  <wpt>
   <name>EHAM-Rwy-24</name>
   <lat>52.304539</lat>
   <lon>4.777361</lon>
   <alt>19.0</alt>
   <ktas>20</ktas>
   <gear-down>true</gear-down>
  </wpt>

  <wpt>
   <name>accel</name>
   <lat>52.303886</lat>
   <lon>4.775642</lon>
   <alt>19.0</alt>
   <ktas>180</ktas>
  </wpt>

  <wpt>
   <name>rotate</name>
   <lat>52.296355</lat>
   <lon>4.755777</lon>
   <alt>250</alt>
   <ktas>220</ktas>
   <gear-down>false</gear-down>
  </wpt>
 
  <wpt>
   <name>runway-end</name>
   <lat>52.296355</lat>
   <lon>4.738186</lon>
   <alt>500</alt>
   <ktas>220</ktas>
  </wpt>

   <wpt>
   <name>EH001</name>
   <lat>52.275278</lat>
   <lon>4.701111</lon>
   <alt>2000</alt>
   <ktas>240</ktas>
  </wpt>
  <!-- up to this point, all runway 24 departures are the same -->
  <!-- for a departure to Delhi, we probably want an ARNHEM dep -->
  <!--
   <wpt>
   <name>EH051</name>
   <lat>52.243889</lat>
   <lon>4.651111</lon>
   <alt>3000</alt>
   <ktas>240</ktas>
  </wpt>
  -->

 <wpt>
   <name>EH026</name>
   <lat>52.171389</lat>
   <lon>4.869722</lon>
   <alt>6000</alt> <!-- Need to pass IVLUT at 6000 ft -->
   <ktas>240</ktas>
  </wpt>

 <wpt>
   <name>IVLUT</name>
   <lat>52.244167</lat>
   <lon>5.256944</lon>
   <alt>33000</alt> <!-- start climb to initial cruise alt -->
   <ktas>450</ktas>
  </wpt>

  <wpt>
   <name>ARNEM</name>
   <lat>52.096389</lat>
   <lon>6.076667</lon>
   <alt>33000</alt>
   <ktas>450</ktas>
  </wpt>
  <!-- Up to this point is a ARNEM 1S departure -->
  <!-- Next, just add one more waypoint to keep the AI system busy -->
  <wpt>
    <name>END</name>
    <lat>28.566496</lat>
    <lon>-77.103091</lon>
    <alt>33000</alt>
    <ktas>500</ktas>
  </wpt>

  <wpt>
   <name>EOF</name>
  </wpt>

 </flightplan>

</PropertyList>
