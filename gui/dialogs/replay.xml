				<green type="float">0.3</green>
				<blue type="float">0.3</blue>
				<alpha type="float">0.8</alpha>
			</color>
			<keynum>358</keynum>
			<binding>
			  <command>nasal</command>
			  <script><![CDATA[
				var t = getprop("/sim/replay/time");
				if (t != "")
				{
					t+=5;
					if (t>getprop("/sim/replay/end-time"))
