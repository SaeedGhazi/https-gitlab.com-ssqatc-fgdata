<?xml version="1.0"?>
<!--
  presets for the ever changing default airport
-->
<PropertyList>
  <sim>
    <presets>
      <airport-id>KBOS</airport-id>
      <runway>15R</runway>
    </presets>
  </sim>
  <instrumentation>
    <!-- Radio settings -->
    <comm n="0">
      <frequencies>
        <!-- TWR -->
        <selected-mhz type="double">132.220</selected-mhz>
        <!-- DEP -->
        <standby-mhz type="double">133.000</standby-mhz>
      </frequencies>
    </comm>
    <comm n="1">
      <frequencies>
        <!-- ATIS -->
        <selected-mhz type="double">135.000</selected-mhz>
        <!-- GND -->
        <standby-mhz type="double">121.900</standby-mhz>
      </frequencies>
    </comm>
    <nav n="0">
      <frequencies>
        <!-- BOSTON VOR-DME (BOS) -->
        <selected-mhz type="double">112.70</selected-mhz>
        <!-- LOC 15R (IMDC) -->
        <standby-mhz type="double">110.70</standby-mhz>
      </frequencies>
      <radials>
        <selected-deg type="double">148</selected-deg>
      </radials>
    </nav>
    <nav n="1">
      <frequencies>
        <!-- Lawrence VOR-DME (LWM) -->
        <selected-mhz type="double">112.500</selected-mhz>
        <!-- Providence VORTAC (PVD) -->
        <standby-mhz type="double">115.60</standby-mhz>
      </frequencies>
      <radials>
        <selected-deg type="double">350</selected-deg>
      </radials>
    </nav>
    <dme n="0">
      <serviceable type="bool" archive="y">true</serviceable>
      <switch-position type="int" archive="y">2</switch-position>
      <frequencies>
        <selected-mhz type="double">112.70</selected-mhz>
        <source>/instrumentation/nav[0]/frequencies/selected-mhz</source>
      </frequencies>
    </dme>
    <adf n="0">
      <frequencies>
        <!-- HULLZ NDB (LI) -->
        <selected-khz type="int">346</selected-khz>
        <!-- MILTT NDB (BO) -->
        <standby-khz type="int">375</standby-khz>
      </frequencies>
      <serviceable type="bool" archive="y">true</serviceable>
      <indicated-bearing-deg type="double">90</indicated-bearing-deg>
      <error-deg type="double">2</error-deg>
      <mode>adf</mode>
      <rotation-deg type="double">0</rotation-deg>
      <volume-norm type="double">0.5</volume-norm>
    </adf>
    <adf n="1">
      <frequencies>
        <!-- LYNDY NDB (LQ)-->
        <selected-khz type="int">382</selected-khz>
        <!-- SHAKER HILL NDB (SKR) -->
        <standby-khz type="int">251</standby-khz>
      </frequencies>
      <serviceable type="bool" archive="y">true</serviceable>
      <indicated-bearing-deg type="double">90</indicated-bearing-deg>
      <error-deg type="double">2</error-deg>
      <mode>adf</mode>
      <rotation-deg type="double">0</rotation-deg>
      <volume-norm type="double">0.5</volume-norm>
    </adf>
  </instrumentation>
</PropertyList>
