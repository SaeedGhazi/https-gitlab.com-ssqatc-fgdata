			<texture-unit>
				<unit>5</unit>
				<image>
					<use>texture[5]/image</use>
				</image>
				<filter>
					<use>texture[5]/filter</use>
				</filter>
				<wrap-s>
					<use>texture[5]/wrap-s</use>
