<?xml version="1.0"?>

<!-- Taller, more pointed flame: narrower cone angles and longer particle
     travel give a slender, sharp-tipped fire instead of the squat base flame. -->
<PropertyList>

	<particlesystem>
		<name>tall-fire-core</name>
		<type>normal</type>
		<texture>../../../Aircraft/Generic/Human/Models/Effects/blaze.png</texture>
		<emissive>true</emissive>
		<lighting>false</lighting>

		<offsets>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
		</offsets>

		<attach>world</attach>

		<placer>
			<type>sector</type>
			<radius-min-m>0</radius-min-m>
			<radius-max-m>0.3</radius-max-m>
			<phi-min-deg>0</phi-min-deg>
			<phi-max-deg>359.5</phi-max-deg>
		</placer>

		<shooter>
			<theta-min-deg>0</theta-min-deg>
			<theta-max-deg>10</theta-max-deg>
			<phi-min-deg>0</phi-min-deg>
			<phi-max-deg>360</phi-max-deg>
			<speed-mps>
				<value>4.5</value>
				<spread>1.5</spread>
			</speed-mps>
			<rotation-speed>
				<x-min-deg-sec>0</x-min-deg-sec>
				<y-min-deg-sec>0</y-min-deg-sec>
				<z-min-deg-sec>-40</z-min-deg-sec>
				<x-max-deg-sec>0</x-max-deg-sec>
				<y-max-deg-sec>0</y-max-deg-sec>
				<z-max-deg-sec>40</z-max-deg-sec>
			</rotation-speed>
		</shooter>

		<counter>
			<particles-per-sec>
				<value>90</value>
				<spread>10</spread>
			</particles-per-sec>
		</counter>

		<align>billboard</align>

		<particle>
			<start>
				<color>
					<red><value>1.0</value></red>
					<green><value>0.95</value></green>
					<blue><value>0.6</value></blue>
					<alpha><value>0.95</value></alpha>
				</color>
				<size><value>0.45</value><spread>0.1</spread></size>
			</start>
			<end>
				<color>
					<red><value>1.0</value></red>
					<green><value>0.55</value></green>
					<blue><value>0.05</value></blue>
					<alpha><value>0.0</value></alpha>
				</color>
				<size><value>0.05</value></size>
			</end>
			<life-sec><value>0.9</value><spread>0.2</spread></life-sec>
			<mass-kg>0.05</mass-kg>
			<radius-m>0.08</radius-m>
		</particle>

		<program>
			<fluid>air</fluid>
			<gravity>false</gravity>
			<wind>true</wind>
		</program>
	</particlesystem>

	<particlesystem>
		<name>tall-fire-licks</name>
		<type>normal</type>
		<texture>../../../Aircraft/Generic/Human/Models/Effects/blaze.png</texture>
		<emissive>true</emissive>
		<lighting>false</lighting>

		<offsets>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
		</offsets>

		<attach>world</attach>

		<placer>
			<type>sector</type>
			<radius-min-m>0</radius-min-m>
			<radius-max-m>0.5</radius-max-m>
			<phi-min-deg>0</phi-min-deg>
			<phi-max-deg>359.5</phi-max-deg>
		</placer>

		<shooter>
			<theta-min-deg>0</theta-min-deg>
			<theta-max-deg>18</theta-max-deg>
			<phi-min-deg>0</phi-min-deg>
			<phi-max-deg>360</phi-max-deg>
			<speed-mps>
				<value>3.2</value>
				<spread>1.0</spread>
			</speed-mps>
			<rotation-speed>
				<x-min-deg-sec>0</x-min-deg-sec>
				<y-min-deg-sec>0</y-min-deg-sec>
				<z-min-deg-sec>-25</z-min-deg-sec>
				<x-max-deg-sec>0</x-max-deg-sec>
				<y-max-deg-sec>0</y-max-deg-sec>
				<z-max-deg-sec>25</z-max-deg-sec>
			</rotation-speed>
		</shooter>

		<counter>
			<particles-per-sec>
				<value>55</value>
				<spread>8</spread>
			</particles-per-sec>
		</counter>

		<align>billboard</align>

		<particle>
			<start>
				<color>
					<red><value>1.0</value></red>
					<green><value>0.45</value></green>
					<blue><value>0.05</value></blue>
					<alpha><value>0.85</value></alpha>
				</color>
				<size><value>0.8</value><spread>0.2</spread></size>
			</start>
			<end>
				<color>
					<red><value>0.55</value></red>
					<green><value>0.08</value></green>
					<blue><value>0.0</value></blue>
					<alpha><value>0.0</value></alpha>
				</color>
				<size><value>0.15</value><spread>0.05</spread></size>
			</end>
			<life-sec><value>1.5</value><spread>0.3</spread></life-sec>
			<mass-kg>0.08</mass-kg>
			<radius-m>0.15</radius-m>
		</particle>

		<program>
			<fluid>air</fluid>
			<gravity>false</gravity>
			<wind>true</wind>
		</program>
	</particlesystem>

	<particlesystem>
		<name>tall-fire-embers</name>
		<type>normal</type>
		<texture>../../../Aircraft/Generic/Human/Models/Effects/spark.png</texture>
		<emissive>true</emissive>
		<lighting>false</lighting>

		<offsets>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
		</offsets>

		<attach>world</attach>

		<placer>
			<type>sector</type>
			<radius-min-m>0</radius-min-m>
			<radius-max-m>0.5</radius-max-m>
			<phi-min-deg>0</phi-min-deg>
			<phi-max-deg>359.5</phi-max-deg>
		</placer>

		<shooter>
			<theta-min-deg>0</theta-min-deg>
			<theta-max-deg>30</theta-max-deg>
			<phi-min-deg>0</phi-min-deg>
			<phi-max-deg>360</phi-max-deg>
			<speed-mps>
				<value>6.5</value>
				<spread>2.5</spread>
			</speed-mps>
			<rotation-speed>
				<x-min-deg-sec>0</x-min-deg-sec>
				<y-min-deg-sec>0</y-min-deg-sec>
				<z-min-deg-sec>0</z-min-deg-sec>
				<x-max-deg-sec>0</x-max-deg-sec>
				<y-max-deg-sec>0</y-max-deg-sec>
				<z-max-deg-sec>0</z-max-deg-sec>
			</rotation-speed>
		</shooter>

		<counter>
			<particles-per-sec>
				<value>10</value>
				<spread>4</spread>
			</particles-per-sec>
		</counter>

		<align>billboard</align>

		<particle>
			<start>
				<color>
					<red><value>1.0</value></red>
					<green><value>0.85</value></green>
					<blue><value>0.3</value></blue>
					<alpha><value>1.0</value></alpha>
				</color>
				<size><value>0.12</value><spread>0.05</spread></size>
			</start>
			<end>
				<color>
					<red><value>0.5</value></red>
					<green><value>0.05</value></green>
					<blue><value>0.0</value></blue>
					<alpha><value>0.0</value></alpha>
				</color>
				<size><value>0.04</value></size>
			</end>
			<life-sec><value>2.6</value><spread>0.6</spread></life-sec>
			<mass-kg>0.01</mass-kg>
			<radius-m>0.03</radius-m>
		</particle>

		<program>
			<fluid>air</fluid>
			<gravity>true</gravity>
			<wind>true</wind>
		</program>
	</particlesystem>

</PropertyList>
