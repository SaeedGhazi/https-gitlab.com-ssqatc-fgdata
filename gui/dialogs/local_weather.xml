  </text>

  <text>
   <x>276</x>
   <y>0</y>
   <label>Delta x (m)</label>
  </text>

  <text>
   <x>349</x>
   <y>0</y>
   <label>x edge</label>
  </text>

  <text>
   <x>422</x>
   <y>0</y>
   <label>number y</label>
  </text>

  <text>
   <x>495</x>
   <y>0</y>
