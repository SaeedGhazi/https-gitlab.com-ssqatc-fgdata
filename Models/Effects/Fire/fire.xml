<?xml version="1.0"?>

<!-- Placeable natural fire model: usable from an .stg OBJECT_STATIC entry
     or spawned at runtime with geo.put_model("Models/Effects/Fire/fire.xml", pos) -->
<PropertyList>

	<path>../../Geometry/null.ac</path>

	<model>
		<path>fire-particles.xml</path>
		<name>Fire</name>
		<offsets>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
		</offsets>
	</model>

	<!-- *** LoD *** -->
	<animation>
		<type>range</type>
		<min-m>0</min-m>
		<max-m>4000</max-m>
	</animation>

</PropertyList>
