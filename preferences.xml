  </systems>
  <instrumentation>
   <path>Aircraft/Generic/generic-instrumentation.xml</path>
  </instrumentation>
  <instrument-options>
   <nav n="0">
    <has-gs-needle type="bool">true</has-gs-needle>
    <needles-pivot type="bool">true</needles-pivot>
