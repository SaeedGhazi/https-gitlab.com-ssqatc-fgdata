<?xml version="1.0"?>

<!-- Taller, sharper-tipped placeable fire (flame only, no smoke). -->
<PropertyList>

	<path>../../Geometry/null.ac</path>

	<model>
		<path>tall-fire-particles.xml</path>
		<name>TallFire</name>
		<offsets>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
		</offsets>
	</model>

	<!-- *** LoD *** -->
	<animation>
		<type>range</type>
		<min-m>0</min-m>
		<max-m>5000</max-m>
	</animation>

</PropertyList>
