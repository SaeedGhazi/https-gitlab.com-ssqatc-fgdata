		<item>
			<name>toggle-glide-slope</name>
			<label>Toggle Glide Slope Tunnel</label>
			<binding>
				<command>nasal</command>
				<script>
					var p = "/sim/rendering/glide-slope-tunnel";
					setprop(p, var i = !getprop(p));
					gui.popupTip("Glide slope tunnel " ~ (i ? "enabled" : "disabled"));
				</script>
			</binding>
		</item>

